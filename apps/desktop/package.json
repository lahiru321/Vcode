{
  "name": "@vcode/desktop",
  "version": "0.1.0",
  "productName": "Vcode",
  "private": true,
  "description": "Vcode desktop app",
  "author": "lahiru321",
  "homepage": "https://github.com/lahiru321/Vcode",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p e2e/tsconfig.json",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "~24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vcode/adapters": "workspace:^",
    "@vcode/shared": "workspace:^",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^8.4.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.6"
  }
}
